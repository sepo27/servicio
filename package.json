{
  "name": "@sepo27/servicio",
  "description": "Backend Service Frame",
  "version": "0.2.11",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "lint": "eslint ./src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:base": "jest -c ./jest.config.js",
    "test": "pnpm test:base ./src",
    "server.sand": "tsx .sandbox/server",
    "prepack": "husky && pnpm run build",
    "version": "conventional-changelog -i CHANGELOG.md -s -n .versionrc.js && git add CHANGELOG.md",
    "release": "./scripts/release.sh"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "conventional-changelog": "^8.1.3",
    "eslint": "^10.14.0",
    "express": "^5.3.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-extended": "^7.0.0",
    "standard-version": "^9.5.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "express": "^5.3.0"
  },
  "keywords": [
    "backend",
    "service",
    "server",
    "framework",
    "express"
  ],
  "author": "Sergey Poskachey",
  "license": "ISC"
}
