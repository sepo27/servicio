{
  "name": "servicio",
  "description": "Backend Service Frame",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "lint": "eslint ./src",
    "typecheck": "tsc --noEmit",
    "prepare": "husky && pnpm run build",
    "version": "conventional-changelog -i CHANGELOG.md -s -n .versionrc.js && git add CHANGELOG.md"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "conventional-changelog": "^8.1.3",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "standard-version": "^9.5.0",
    "typescript": "^6.0.3"
  },
  "keywords": [],
  "author": "Sergey Poskachey",
  "license": "ISC"
}
