{
  "name": "servicio",
  "description": "Backend Service Frame",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "lint": "eslint ./src",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  },
  "keywords": [],
  "author": "Sergey Poskachey",
  "license": "ISC"
}
